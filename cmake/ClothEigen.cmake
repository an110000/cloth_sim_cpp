# Offline dependency: this is a locally repackaged, unmodified Eigen header tree.
set(cloth_eigen_sha256 b5e679981cf1c843ade160aeda435e05de917f653b29e8d5ab854acdfa128adf)
set(cloth_eigen_archive "${CMAKE_CURRENT_LIST_DIR}/../third_party/eigen-5.0.0-headers.tar.gz")
file(SHA256 "${cloth_eigen_archive}" cloth_eigen_actual)
if(NOT cloth_eigen_actual STREQUAL cloth_eigen_sha256)
    message(FATAL_ERROR "Bundled Eigen archive SHA256 mismatch")
endif()
set(cloth_eigen_root "${CMAKE_CURRENT_BINARY_DIR}/_deps/eigen-b5e679981cf1c843")
if(NOT EXISTS "${cloth_eigen_root}/Eigen/Version")
    file(MAKE_DIRECTORY "${cloth_eigen_root}")
    file(ARCHIVE_EXTRACT INPUT "${cloth_eigen_archive}" DESTINATION "${cloth_eigen_root}")
endif()
file(STRINGS "${cloth_eigen_root}/Eigen/Version" cloth_eigen_version
    REGEX "^#define EIGEN_VERSION_STRING ")
if(NOT cloth_eigen_version STREQUAL "#define EIGEN_VERSION_STRING \"5.0.0\"")
    message(FATAL_ERROR "Expected the pinned Eigen 5.0.0 headers")
endif()
add_library(cloth_eigen_headers INTERFACE)
target_include_directories(cloth_eigen_headers SYSTEM INTERFACE "${cloth_eigen_root}")
target_compile_definitions(cloth_eigen_headers INTERFACE EIGEN_MPL2_ONLY EIGEN_DONT_PARALLELIZE)
