foreach(mode IN ITEMS budget strict no_bending)
    set(args --output "${OUTPUT_ROOT}/${mode}")
    if(mode STREQUAL "strict")
        list(APPEND args --strict --iterations 1 --distance-tolerance 1e-14 --angle-tolerance 1e-14)
        set(expected_exit 2)
        set(expected_steps 0)
        set(expected_committed OFF)
    else()
        set(expected_exit 0)
        set(expected_steps 8)
        set(expected_committed ON)
        if(mode STREQUAL "no_bending")
            list(APPEND args --no-bending)
        endif()
    endif()
    execute_process(COMMAND "${SIMULATOR}" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT result STREQUAL "${expected_exit}")
        message(FATAL_ERROR "XPBD CLI ${mode}: exit ${result}, expected ${expected_exit}: ${output} ${errors}")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/summary.json" summary)
    string(JSON completed GET "${summary}" steps_completed)
    string(JSON committed GET "${summary}" committed)
    string(JSON finite GET "${summary}" finite_state)
    string(JSON converged GET "${summary}" projection_converged)
    string(JSON reason GET "${summary}" failure_reason)
    if(NOT completed EQUAL expected_steps OR NOT committed STREQUAL expected_committed OR NOT finite)
        message(FATAL_ERROR "XPBD CLI ${mode} state contract failed: ${summary}")
    endif()
    if(mode STREQUAL "strict" AND (converged OR NOT reason STREQUAL "projection_not_converged"))
        message(FATAL_ERROR "Strict failure must report failed compliant residual test")
    endif()
    if(mode STREQUAL "no_bending")
        string(JSON bending_count GET "${summary}" groups bending count)
        if(NOT bending_count EQUAL 0)
            message(FATAL_ERROR "Disabled bending still has constraints")
        endif()
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/config.json" config)
    string(JSON vertices LENGTH "${config}" initial_positions)
    file(STRINGS "${OUTPUT_ROOT}/${mode}/trajectory.csv" rows)
    list(LENGTH rows row_count)
    math(EXPR expected_rows "1 + ${vertices} * (${expected_steps} + 1)")
    if(NOT row_count EQUAL expected_rows)
        message(FATAL_ERROR "XPBD CLI contains missing or uncommitted frames")
    endif()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/diagnostics.csv" diagnostic_rows)
    list(LENGTH diagnostic_rows diagnostic_count)
    math(EXPR expected_diagnostics "${expected_steps} + 1")
    if(NOT diagnostic_count EQUAL expected_diagnostics)
        message(FATAL_ERROR "XPBD CLI diagnostic history has wrong number of committed frames")
    endif()
endforeach()
execute_process(COMMAND "${SIMULATOR}" --iterations 0
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
if(NOT result STREQUAL "1")
    message(FATAL_ERROR "XPBD CLI must reject zero iteration budget with exit 1")
endif()
