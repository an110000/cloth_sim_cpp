if(NOT DEFINED SIMULATOR OR NOT DEFINED OUTPUT_ROOT)
    message(FATAL_ERROR "CLI contract test requires executable and output directory")
endif()
foreach(mode IN ITEMS lumped consistent failure)
    set(args --output "${OUTPUT_ROOT}/${mode}")
    if(mode STREQUAL "failure")
        list(APPEND args --max-iterations 0)
        set(expected_exit 2)
        set(expected_steps 0)
        set(expected_committed OFF)
        set(expected_reason iteration_limit)
    else()
        list(APPEND args --mass ${mode})
        set(expected_exit 0)
        set(expected_steps 8)
        set(expected_committed ON)
        set(expected_reason none)
    endif()
    execute_process(COMMAND "${SIMULATOR}" ${args}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT result STREQUAL "${expected_exit}")
        message(FATAL_ERROR "CLI ${mode}: exit ${result}, expected ${expected_exit}: ${output} ${errors}")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/summary.json" summary)
    string(JSON completed GET "${summary}" steps_completed)
    string(JSON committed GET "${summary}" committed)
    string(JSON converged GET "${summary}" solver_converged)
    string(JSON finite GET "${summary}" finite_state)
    string(JSON reason GET "${summary}" failure_reason)
    if(NOT completed EQUAL expected_steps OR NOT committed STREQUAL expected_committed OR
       NOT converged STREQUAL expected_committed OR NOT finite OR NOT reason STREQUAL expected_reason)
        message(FATAL_ERROR "CLI ${mode}: invalid summary: ${summary}")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/config.json" config)
    string(JSON vertices LENGTH "${config}" initial_positions)
    file(STRINGS "${OUTPUT_ROOT}/${mode}/trajectory.csv" rows)
    list(LENGTH rows row_count)
    math(EXPR expected_rows "1 + ${vertices} * (${expected_steps} + 1)")
    if(NOT row_count EQUAL expected_rows)
        message(FATAL_ERROR "CLI ${mode}: trajectory contains uncommitted or missing frames")
    endif()
endforeach()
execute_process(COMMAND "${SIMULATOR}" --dt NaN
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 5)
if(NOT result STREQUAL "1")
    message(FATAL_ERROR "CLI must reject non-finite dt with exit 1")
endif()
message(STATUS "CLI success, rollback, JSON, trajectory and invalid-argument contracts passed")
