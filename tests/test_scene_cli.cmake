if(NOT DEFINED SIMULATOR OR NOT DEFINED SCENE OR NOT DEFINED OUTPUT_ROOT)
    message(FATAL_ERROR "Task06 scene CLI contract requires executable, scene and output")
endif()
file(REMOVE_RECURSE "${OUTPUT_ROOT}")
file(MAKE_DIRECTORY "${OUTPUT_ROOT}")
set(report "${OUTPUT_ROOT}/run.txt")
execute_process(COMMAND "${SIMULATOR}" --scene "${SCENE}" --output "${report}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Task06 scene run failed: ${result}: ${output} ${errors}")
endif()
file(READ "${report}" text)
if(NOT text MATCHES "status=committed" OR NOT text MATCHES "requested_steps=[0-9]+" OR
   NOT text MATCHES "committed_steps=[0-9]+" OR NOT text MATCHES "frame [0-9]+ 0.01")
    message(FATAL_ERROR "Task06 report is incomplete or non-reproducible: ${text}")
endif()
execute_process(COMMAND "${SIMULATOR}" --scene "${SCENE}" --output "${OUTPUT_ROOT}/run2.txt"
    RESULT_VARIABLE replay_result TIMEOUT 20)
if(NOT replay_result STREQUAL "0")
    message(FATAL_ERROR "Task06 replay failed: ${replay_result}")
endif()
file(READ "${OUTPUT_ROOT}/run2.txt" replay)
string(REGEX REPLACE "wall_clock_seconds=[^\n]*\n" "" text_without_timing "${text}")
string(REGEX REPLACE "solver_seconds=[^\n]*\n" "" text_without_timing "${text_without_timing}")
string(REGEX REPLACE "wall_clock_seconds=[^\n]*\n" "" replay_without_timing "${replay}")
string(REGEX REPLACE "solver_seconds=[^\n]*\n" "" replay_without_timing "${replay_without_timing}")
if(NOT text_without_timing STREQUAL replay_without_timing)
    message(FATAL_ERROR "Task06 repeated physical output is not byte-identical after timing fields are removed")
endif()
execute_process(COMMAND "${SIMULATOR}" --scene "${SCENE}" --output "${OUTPUT_ROOT}/run2.txt"
    RESULT_VARIABLE third_result TIMEOUT 20)
if(third_result STREQUAL "0")
    message(FATAL_ERROR "Existing report path unexpectedly replaced")
endif()
message(STATUS "Task06 scene parsing, committed frames, deterministic replay and atomic output passed")
