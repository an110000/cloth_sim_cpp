foreach(mode IN ITEMS implicit consistent distance energy strict failure)
    set(args --ground-y -0.03 --friction 0.3 --static-friction 0.5
        --output "${OUTPUT_ROOT}/${mode}")
    set(expected_exit 0)
    set(expected_steps 8)
    if(mode STREQUAL "implicit" OR mode STREQUAL "consistent" OR mode STREQUAL "failure")
        set(program "${IMPLICIT}")
        list(APPEND args --contact-eta 30)
        if(mode STREQUAL "consistent")
            list(APPEND args --mass consistent)
        elseif(mode STREQUAL "failure")
            list(APPEND args --max-iterations 0)
            set(expected_exit 2)
            set(expected_steps 0)
        endif()
    else()
        set(program "${XPBD}")
        if(mode STREQUAL "energy")
            list(APPEND args --model energy)
        elseif(mode STREQUAL "strict")
            list(APPEND args --strict --distance-tolerance 1e-14 --angle-tolerance 1e-14)
            set(expected_exit 2)
            set(expected_steps 0)
        endif()
    endif()
    execute_process(COMMAND "${program}" ${args} RESULT_VARIABLE exit_code
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT exit_code STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Contact ${mode}: ${exit_code}: ${output} ${errors}")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/summary.json" summary)
    string(JSON completed GET "${summary}" steps_completed)
    if(NOT completed EQUAL expected_steps)
        message(FATAL_ERROR "Contact CLI did not commit the expected steps")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/config.json" config)
    string(JSON enabled GET "${config}" contact)
    string(JSON mass GET "${config}" contact_parameters nodal_mass)
    if(NOT enabled OR NOT mass STREQUAL "physical_lumped")
        message(FATAL_ERROR "Contact configuration not reproducible")
    endif()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/contact.csv" rows)
    list(LENGTH rows count)
    math(EXPR expected_rows "${expected_steps}+1")
    if(NOT count EQUAL expected_rows)
        message(FATAL_ERROR "Contact CSV includes rejected steps or lacks committed steps")
    endif()
    list(REMOVE_AT rows 0)
    foreach(row IN LISTS rows)
        string(REPLACE "," ";" values "${row}")
        list(LENGTH values fields)
        if(NOT fields EQUAL 13 OR row MATCHES "nan|inf")
            message(FATAL_ERROR "Invalid contact CSV row: ${row}")
        endif()
        foreach(index IN ITEMS 5 6 7 8 9)
            list(GET values ${index} value)
            if(value LESS 0)
                message(FATAL_ERROR "Negative penetration/impulse/dissipation")
            endif()
        endforeach()
        if(mode STREQUAL "distance" OR mode STREQUAL "energy")
            list(GET values 6 penetration_after)
            if(penetration_after GREATER 1e-12)
                message(FATAL_ERROR "Projected ground penetration remains")
            endif()
        endif()
    endforeach()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/trajectory.csv" frames)
    list(LENGTH frames frame_rows)
    math(EXPR expected_frames "1+6*(${expected_steps}+1)")
    if(NOT frame_rows EQUAL expected_frames)
        message(FATAL_ERROR "Rejected states appeared in trajectory")
    endif()
endforeach()
execute_process(COMMAND "${XPBD}" --model distance --no-bending --ground-y 1e200
    --friction 0 --steps 1 --output "${OUTPUT_ROOT}/diagnostic-overflow"
    RESULT_VARIABLE diagnostic_exit OUTPUT_QUIET ERROR_VARIABLE diagnostic_error TIMEOUT 5)
if(NOT diagnostic_exit STREQUAL "0")
    message(FATAL_ERROR "A non-applicable NH diagnostic aborted a committed distance step: ${diagnostic_error}")
endif()
file(READ "${OUTPUT_ROOT}/diagnostic-overflow/summary.json" diagnostic_summary)
string(JSON valid GET "${diagnostic_summary}" diagnostic_energies_valid)
string(JSON committed GET "${diagnostic_summary}" committed)
if(valid OR NOT committed)
    message(FATAL_ERROR "NH diagnostic failure must be explicit and preserve the distance-step result")
endif()
foreach(program IN ITEMS "${IMPLICIT}" "${XPBD}")
    foreach(bad IN ITEMS missing_ground invalid_mu bad_static missing_value)
        if(bad STREQUAL "missing_ground")
            set(args --friction .3)
        elseif(bad STREQUAL "invalid_mu")
            set(args --ground-y 0 --friction -1)
        elseif(bad STREQUAL "bad_static")
            set(args --ground-y 0 --friction .5 --static-friction .1)
        else()
            set(args --ground-y)
        endif()
        execute_process(COMMAND "${program}" ${args} RESULT_VARIABLE exit_code
            OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
        if(NOT exit_code STREQUAL "1")
            message(FATAL_ERROR "Invalid contact arguments accepted: ${bad}")
        endif()
    endforeach()
endforeach()
message(STATUS "Contact CLI paths, rollback, records and invalid arguments verified")
