foreach(mode IN ITEMS budget strict scaled)
    set(args --model energy --output "${OUTPUT_ROOT}/${mode}")
    if(mode STREQUAL "strict")
        list(APPEND args --strict --iterations 1 --energy-tolerance 1e-14)
        set(expected_exit 2)
        set(expected_steps 0)
        set(expected_committed OFF)
    else()
        set(expected_exit 0)
        set(expected_steps 8)
        set(expected_committed ON)
        if(mode STREQUAL "scaled")
            list(APPEND args --energy-scale 3 --energy-compliance 1.1111111111111111e-9)
        endif()
    endif()
    execute_process(COMMAND "${SIMULATOR}" ${args} RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 20)
    if(NOT result STREQUAL "${expected_exit}")
        message(FATAL_ERROR "Energy CLI ${mode}: ${result}: ${output} ${errors}")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/summary.json" summary)
    string(JSON completed GET "${summary}" steps_completed)
    string(JSON committed GET "${summary}" committed)
    string(JSON converged GET "${summary}" projection_converged)
    string(JSON reason GET "${summary}" failure_reason)
    string(JSON constraints GET "${summary}" groups neohookean_energy count)
    string(JSON unit GET "${summary}" groups neohookean_energy unit)
    if(NOT completed EQUAL expected_steps OR NOT committed STREQUAL expected_committed OR
       NOT constraints EQUAL 4 OR NOT unit STREQUAL "1")
        message(FATAL_ERROR "Energy CLI state/group contract: ${summary}")
    endif()
    if(mode STREQUAL "strict" AND (converged OR NOT reason STREQUAL "projection_not_converged"))
        message(FATAL_ERROR "Strict energy solve must reject unmet residual tolerance")
    endif()
    file(READ "${OUTPUT_ROOT}/${mode}/config.json" config)
    string(JSON solver GET "${config}" solver)
    string(JSON bending GET "${config}" bending_enabled)
    if(NOT solver STREQUAL "xpbd_neohookean_energy" OR bending)
        message(FATAL_ERROR "Energy model cannot silently include distance or hinge constraints")
    endif()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/trajectory.csv" rows)
    list(LENGTH rows row_count)
    math(EXPR expected_rows "1 + 6 * (${expected_steps} + 1)")
    if(NOT row_count EQUAL expected_rows)
        message(FATAL_ERROR "Uncommitted or missing energy trajectory frame")
    endif()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/diagnostics.csv" diagnostic_rows)
    list(LENGTH diagnostic_rows diagnostic_count)
    math(EXPR expected_diagnostics "1 + ${expected_steps}")
    if(NOT diagnostic_count EQUAL expected_diagnostics)
        message(FATAL_ERROR "Wrong number of committed energy diagnostics")
    endif()
    file(STRINGS "${OUTPUT_ROOT}/${mode}/multipliers.csv" multiplier_rows)
    list(LENGTH multiplier_rows multiplier_count)
    math(EXPR expected_multipliers "1 + 4 * ${expected_steps}")
    if(NOT multiplier_count EQUAL expected_multipliers)
        message(FATAL_ERROR "Multipliers must belong to committed time steps")
    endif()
    foreach(row IN LISTS diagnostic_rows)
        string(REPLACE "," ";" fields "${row}")
        list(LENGTH fields columns)
        if(NOT columns EQUAL 12)
            message(FATAL_ERROR "CSV header/data columns differ: ${row}")
        endif()
    endforeach()
endforeach()
foreach(option IN ITEMS --energy-scale --energy-tolerance)
    execute_process(COMMAND "${SIMULATOR}" --model energy ${option} 0
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
    if(NOT result STREQUAL "1")
        message(FATAL_ERROR "Energy CLI must reject zero ${option}")
    endif()
endforeach()
execute_process(COMMAND "${SIMULATOR}" --energy-scale 3 RESULT_VARIABLE result
    OUTPUT_QUIET ERROR_QUIET TIMEOUT 5)
if(NOT result STREQUAL "1")
    message(FATAL_ERROR "Energy-only parameter must not be silently ignored in distance model")
endif()
